<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_artwork" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginEnd="14dp" android:src="@drawable/ic_launcher" android:scaleType="centerCrop" android:contentDescription="DimLife Радио" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● DIMLIFE RADIO • ПРЯМОЙ ЭФИР" android:textColor="#43F28B" android:textStyle="bold" android:textSize="10sp" />
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DimLife Radio" android:textColor="#F3FFF7" android:textStyle="bold" android:textSize="18sp" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Частный InterNet Проект" android:textColor="#9BAFA2" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="radio.dimlife.ru" android:textColor="#43F28B" android:textSize="10sp" android:layout_marginTop="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_play" android:layout_width="58dp" android:layout_height="58dp" android:gravity="center" android:background="@drawable/widget_play_background" android:text="▶" android:textColor="#07070D" android:textStyle="bold" android:textSize="25sp" />
</LinearLayout>
